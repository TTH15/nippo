{
  "name": "nippo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @repo/web run dev",
    "preview:admin": "node scripts/serve-admin-preview.mjs",
    "build": "npm -w @repo/web run build",
    "start": "npm -w @repo/web run start",
    "test": "npm -w @repo/web run test",
    "test:watch": "npm -w @repo/web run test:watch",
    "test:itest": "npm -w @repo/web run test:itest",
    "seed": "npm -w @repo/web run seed",
    "db:migrate": "npm -w @repo/web run db:migrate",
    "mobile": "npm -w @repo/mobile run start",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "sharp": "^0.35.3"
  }
}
