{
  "name": "nippo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @repo/web run dev",
    "preview:admin": "node scripts/serve-admin-preview.mjs",
    "build": "npm -w @repo/web run build",
    "start": "npm -w @repo/web run start",
    "test": "npm -w @repo/web run test",
    "test:watch": "npm -w @repo/web run test:watch",
    "test:itest": "npm -w @repo/web run test:itest",
    "seed": "npm -w @repo/web run seed",
    "db:migrate": "npm -w @repo/web run db:migrate",
    "mobile": "npm -w @repo/mobile run start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "npm run typecheck -w @repo/web && npm run typecheck:preview -w @repo/web && npm run typecheck -w @repo/mobile && npm run typecheck -w @repo/base",
    "check:tenant": "npm -w @repo/web run check:tenant"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@anthropic-ai/sdk": {
      "zod": "4.6.6"
    },
    "openai": {
      "zod": "4.6.6"
    },
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "motion": "12.42.2",
    "framer-motion": "12.42.2",
    "motion-dom": "12.42.2",
    "happy-dom": "21.0.4",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "sharp": "0.35.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4"
  },
  "packageManager": "npm@11.21.1"
}
