# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: match at any depth)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js (monorepo: match at any depth)
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI temp
supabase/.temp/

# Expo prebuild artifacts must live in apps/*, never at repo root
/ios/
/android/
/app.json
.expo/

# Meshy などから落とした生の3Dモデル（作業用の元ファイル）。
# 実行時に使うのは整形後の apps/web/public/models/*.glb だけ。
# 生ファイルは1本100MB近くあり、git に入れるとクローンが数分単位で遅くなる（2026-08-11 に実害）。
apps/web/public/glb/

# サードパーティ配布のスキル（uipro init で展開。ハコ虎固有の定義は .claude/agents と .codex/skills に置く）
.claude/skills/
