# Next.js API の絶対オリジン（RN は相対パス不可のため必須）。末尾スラッシュは付けない。
#
# 手早く疎通だけ見る（ログインは非破壊なので本番でも可）:
#   EXPO_PUBLIC_API_BASE_URL=https://nippo-ace.vercel.app
#
# 開発の推奨（書き込み画面を試すとき）= ローカル dev サーバを LAN IP で叩く:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:3000
#   （PC で `npm run dev`、スマホと同一 Wi-Fi。ただし DB は dev サーバの接続先に依存）
EXPO_PUBLIC_API_BASE_URL=

# 会社コード接頭辞（テナント/ブランド確定までは仮）。当面 ACE。
EXPO_PUBLIC_COMPANY_CODE=ACE
