{
  "expo": {
    "name": "Nippo Mobile (dev)",
    "slug": "nippo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.hakotora.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "jp.hakotora.app"
    },
    "extra": {
      "_note": "bundleId は jp.hakotora.app で確定（2026-07-27）。name/slug は EAS 設定（eas init）時に確定させる。"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "免許証・顔写真の登録のために写真ライブラリにアクセスします。",
          "cameraPermission": "免許証・顔写真の撮影のためにカメラにアクセスします。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "車両QRの読み取り・メーター撮影のためにカメラにアクセスします。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "出退勤の打刻位置・駐車位置の記録のために位置情報を使用します（任意）。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "アプリのロック解除に Face ID を使用します。"
        }
      ],
      "expo-font"
    ]
  }
}
