{
  "expo": {
    "name": "ハコ虎",
    "slug": "hakotora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.hakotora.app",
      "infoPlist": {},
      "associatedDomains": [
        "webcredentials:hakotora.jp"
      ]
    },
    "android": {
      "package": "jp.hakotora.app"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "免許証・顔写真の登録のために写真ライブラリにアクセスします。",
          "cameraPermission": "免許証・顔写真の撮影のためにカメラにアクセスします。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "車両QRの読み取り・メーター撮影のためにカメラにアクセスします。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "稼働中から駐車完了まで車両の位置を記録するために使用します。",
          "locationAlwaysAndWhenInUsePermission": "稼働中から駐車完了まで、アプリを閉じている間も車両の位置を共有するために使用します。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "アプリのロック解除に Face ID を使用します。"
        }
      ],
      "expo-font"
    ],
    "scheme": "hakotora",
    "icon": "./assets/logo-icon.png",
    "extra": {
      "eas": {
        "projectId": "c874c3eb-642e-4670-8706-31e47e821d76"
      }
    },
    "owner": "next-eight"
  }
}
