{
  "expo": {
    "name": "Nippo Mobile (dev)",
    "slug": "nippo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.nippomobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.example.nippomobile"
    },
    "extra": {
      "_note": "name/slug/bundleId はブランド未確定のため仮。確定後にリネーム。"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "免許証・顔写真の登録のために写真ライブラリにアクセスします。",
          "cameraPermission": "免許証・顔写真の撮影のためにカメラにアクセスします。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "車両QRの読み取り・メーター撮影のためにカメラにアクセスします。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "出退勤の打刻位置・駐車位置の記録のために位置情報を使用します（任意）。"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ]
  }
}
