{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://hakotora.jp",
        "EXPO_PUBLIC_PASSKEY_ENABLED": "true"
      },
      "environment": "development"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://hakotora.jp",
        "EXPO_PUBLIC_PASSKEY_ENABLED": "true"
      },
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://hakotora.jp",
        "EXPO_PUBLIC_PASSKEY_ENABLED": "true"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
